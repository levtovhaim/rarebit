# Code owners: who reviews changes to which paths.
# GitHub requests a review from the owners of every path a PR touches. Required code-owner
# approval is switched on later in the ruleset; until then this file routes review requests.
# The LAST matching pattern wins: put broad rules first and specific paths after them.
# Syntax: <pattern> <@user or @org/team>...  A leading "/" anchors to the repo root, and a
# trailing "/" matches a directory.
#
# Platform and process: whatever changes how code is built, deployed, secured or reviewed.
# No catch-all owner: app code (apps/, native/), data/ and most of docs/ flow without a review
# request, so a request from this file always means "this touches the platform".

# CI/CD, repository config, and this file itself
/.github/                  @haimlevtov

# Which runner fleet each CI job class uses
/ci/                       @haimlevtov

# Infrastructure (Terraform modules and the Terragrunt live layer)
/infra/                    @haimlevtov

# GitOps: Argo CD apps, cluster addons, per-environment values and the shared chart
/deploy/                   @haimlevtov
# ...except the image-tag files: promotion PRs change only these and must merge without a human
/deploy/envs/**/image-tags.yaml

# The platform CLI (`plat env up/down` creates and destroys the AWS platform) and policies
/platform/                 @haimlevtov

# Decisions: an accepted ADR is superseded by a new one, never edited
/docs/adr/                 @haimlevtov

# Quality gates, tool versions and repository hygiene (an agent must not quietly weaken checks,
# swap tools or stop ignoring local secrets)
/Makefile                  @haimlevtov
/.pre-commit-config.yaml   @haimlevtov
/.mise.toml                @haimlevtov
/.yamllint.yaml            @haimlevtov
/.gitignore                @haimlevtov
/.gitattributes            @haimlevtov
/.editorconfig             @haimlevtov

# Rules, guardrails and playbooks for contributors and agents
/CLAUDE.md                 @haimlevtov
/.claude/                  @haimlevtov

# Service ownership and SLOs
/catalog/                  @haimlevtov
