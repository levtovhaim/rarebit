{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AWS_PROFILE": "rarebit",
    "AWS_REGION": "eu-central-1"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(terraform *apply*)",
      "Bash(terraform *destroy*)",
      "Bash(terraform *import*)",
      "Bash(terraform *state*)",
      "Bash(terraform *force-unlock*)",
      "Bash(terragrunt *apply*)",
      "Bash(terragrunt *destroy*)",
      "Bash(terragrunt *import*)",
      "Bash(terragrunt *state*)",
      "Bash(terragrunt *run*)",
      "Bash(terragrunt *force-unlock*)",
      "Bash(terraform *refresh*)",
      "Bash(terragrunt *refresh*)",
      "Bash(terraform *taint*)",
      "Bash(terragrunt *taint*)",
      "Bash(terraform *test*)",
      "Bash(terragrunt *test*)",
      "Bash(plat env *)",
      "Bash(kubectl *apply*)",
      "Bash(kubectl *delete*)",
      "Bash(kubectl *drain*)",
      "Bash(kubectl *scale*)",
