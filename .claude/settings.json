      "Bash(kubectl *taint*)",
      "Bash(helm *install*)",
      "Bash(helm *upgrade*)",
      "Bash(helm *rollback*)",
      "Bash(helm *delete*)",
      "Bash(aws *create-*)",
      "Bash(aws *delete-*)",
      "Bash(aws *modify-*)",
      "Bash(aws *put-*)",
      "Bash(aws *run-*)",
      "Bash(aws *terminate-*)",
      "Bash(aws *update-*)",
      "Bash(gh pr merge *)",
      "Bash(gh secret *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(argocd *sync*)",
      "Bash(argocd *delete*)",
      "Bash(argocd *rollback*)",
      "Bash(argocd *create*)",
      "Bash(argocd *patch*)",
      "Bash(argocd * set *)",
      "Bash(docker *push*)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git push * +*)",
      "PowerShell(terraform *apply*)",
      "PowerShell(terraform *destroy*)",
      "PowerShell(terraform *import*)",
      "PowerShell(terraform *state*)",
      "PowerShell(terraform *force-unlock*)",
      "PowerShell(terragrunt *apply*)",
      "PowerShell(terragrunt *destroy*)",
      "PowerShell(terragrunt *import*)",
      "PowerShell(terragrunt *state*)",
      "PowerShell(terragrunt *run*)",
      "PowerShell(terragrunt *force-unlock*)",
      "PowerShell(terraform *refresh*)",
      "PowerShell(terragrunt *refresh*)",
      "PowerShell(terraform *taint*)",
      "PowerShell(terragrunt *taint*)",
      "PowerShell(terraform *test*)",
      "PowerShell(terragrunt *test*)",
      "PowerShell(plat env *)",
      "PowerShell(kubectl *apply*)",
      "PowerShell(kubectl *delete*)",
      "PowerShell(kubectl *drain*)",
      "PowerShell(kubectl *scale*)",
      "PowerShell(kubectl *edit*)",
      "PowerShell(kubectl *patch*)",
      "PowerShell(kubectl *replace*)",
      "PowerShell(kubectl *create*)",
      "PowerShell(kubectl *rollout*)",
      "PowerShell(kubectl *cordon*)",
      "PowerShell(kubectl *taint*)",
      "PowerShell(helm *install*)",
      "PowerShell(helm *upgrade*)",
      "PowerShell(helm *rollback*)",
      "PowerShell(helm *delete*)",
      "PowerShell(aws *create-*)",
      "PowerShell(aws *delete-*)",
      "PowerShell(aws *modify-*)",
      "PowerShell(aws *put-*)",
      "PowerShell(aws *run-*)",
      "PowerShell(aws *terminate-*)",
      "PowerShell(aws *update-*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh variable set *)",
      "PowerShell(gh variable delete *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh repo archive *)",
      "PowerShell(gh repo rename *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh workflow enable *)",
      "PowerShell(gh workflow disable *)",
      "PowerShell(gh run rerun *)",
      "PowerShell(gh run cancel *)",
      "PowerShell(gh run delete *)",
      "PowerShell(gh release create *)",
      "PowerShell(gh release delete *)",
      "PowerShell(argocd *sync*)",
      "PowerShell(argocd *delete*)",
      "PowerShell(argocd *rollback*)",
      "PowerShell(argocd *create*)",
      "PowerShell(argocd *patch*)",
      "PowerShell(argocd * set *)",
      "PowerShell(docker *push*)",
      "PowerShell(git push *--force-with-lease*)",
      "PowerShell(git push * +*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "Bash(git *--no-verify*)",
      "Bash(git commit -n*)",
      "PowerShell(git *--no-verify*)",
      "PowerShell(git commit -n*)",
      "Bash(*.aws*credentials*)",
      "Bash(*.aws*login*cache*)",
      "Bash(*.aws*sso*cache*)",
      "Bash(*.aws*cli*cache*)",
      "PowerShell(*.aws*credentials*)",
      "PowerShell(*.aws*login*cache*)",
      "PowerShell(*.aws*sso*cache*)",
      "PowerShell(*.aws*cli*cache*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/login/cache/**)",
      "Read(~/.aws/sso/cache/**)",
      "Read(~/.aws/cli/cache/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/AppData/Roaming/GitHub CLI/hosts.yml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*aws*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/readonly-gate.sh\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking aws call"
          },
          {
            "type": "command",
            "if": "Bash(*gh*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/readonly-gate.sh\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking gh api call"
          },
          {
            "type": "command",
            "if": "PowerShell(*aws*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/readonly-gate.sh\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking aws call"
          },
          {
            "type": "command",
            "if": "PowerShell(*gh*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/readonly-gate.sh\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking gh api call"
          }
        ]
      }
    ]
  }
}
