# Build context for apps/web/Dockerfile (the context is the repo root; BuildKit reads this file
# instead of the root .dockerignore). An allowlist of exactly what the build uses: no tests, no
# local node_modules or dist.
*
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/.npmrc
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/src/
!apps/web/nginx.conf
# A second guard inside those paths: untracked local config never goes in.
**/.env
**/.env.*
**/*.pem
**/*.key
**/.vscode/
**/.idea/
