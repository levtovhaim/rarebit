{
  "name": "@rarebit/bots",
  "version": "0.1.0",
  "private": true,
  "description": "Rarebit simulated players: the synthetic game, load tests and the chaos observer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/bots.integration.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@types/estree": "1.0.10",
    "source-map-js": "1.2.2",
    "tinybench": "6.2.3",
    "tinyexec": "1.3.1"
  }
}
